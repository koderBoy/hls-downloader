{
  "name": "hls-downloader-gui",
  "version": "1.0.0",
  "private": true,
  "description": "hls-downloader 的图形界面（Electron 封装）",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "smoke": "node launch.js --smoke-test",
    "test": "node test/gui-smoke.js",
    "icon": "node tools/make-icon.js",
    "vendor": "node tools/fetch-ffmpeg.js",
    "prebuild": "node tools/make-icon.js && node tools/fetch-ffmpeg.js",
    "build": "node tools/build.js",
    "build:dir": "node tools/build.js --dir-only"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  }
}
