# ── 依赖 ──────────────────────────────────────────────
# Electron 二进制 ~370MB，用 `npm install` 重新拉
node_modules/

# ── 内置二进制（不入库）────────────────────────────────
# ffmpeg / ffprobe 精简静态版，各 77MB。用 `npm run vendor` 重新拉
vendor/

# ── 打包产物（不入库）──────────────────────────────────
# 便携版 exe 133MB / zip 199MB / 免安装目录 523MB。用 `npm run build` 重新生成
dist/

# ── 自测产物 ──────────────────────────────────────────
# 自测的样本和输出都落在系统临时目录，正常不会污染仓库；
# 但 CLI 加 --keep-temp 时会把中间文件留在 ./hlsdl-work-*，顺手忽略掉
hlsdl-work-*/
hlsdl-*/

# ── 杂项 ──────────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*~
